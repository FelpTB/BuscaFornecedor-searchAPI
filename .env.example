# --- Obrigatórias (Railway → Variables ou .env local) ---
QDRANT_KEY=
CLUSTER_ENDPOINT=
COLLECTION_NAME=
OPENAI_API_KEY=

# Dimensões densas (ordem 1:1 com QDRANT_VECTOR_NAMES)
QDRANT_DIMENSION_KEYS=produto,servico,descricao,publico,cliente
QDRANT_VECTOR_NAMES=v_produto,v_servico,v_descricao,v_publico,v_cliente

# Filtros
# QDRANT_PAYLOAD_KEYS=modelo_negocio,cidade,uf,nome_empresa,cnpj
# QDRANT_PAYLOAD_KEYS_TEXT=descricao,endereco,publico,site,email,certificacoes

# BM25 híbrido
# QDRANT_BM25_VECTOR_NAME=bm25_complete_profile
# QDRANT_BM25_MODEL=qdrant/bm25
# RRF_K=60

# OpenAI
# OPENAI_EMBED_DIMENSIONS=1536
# LLM_RERANK_MODEL=gpt-4o-mini

# Servidor (Railway injeta PORT automaticamente — não fixe em produção)
# PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Teste MCP local
# MCP_URL=http://127.0.0.1:3000/mcp
