# --- Obrigatórias (Railway → Variables ou .env local) ---
QDRANT_KEY=
CLUSTER_ENDPOINT=
COLLECTION_NAME=
OPENAI_API_KEY=

# Dimensões densas (ordem 1:1 com QDRANT_VECTOR_NAMES)
QDRANT_DIMENSION_KEYS=produto,servico,descricao,publico,cliente
QDRANT_VECTOR_NAMES=v_produto,v_servico,v_descricao,v_publico,v_cliente

# Filtros (allowlist)
# QDRANT_PAYLOAD_KEYS=modelo_negocio,cidade,uf,nome_empresa,cnpj
# QDRANT_PAYLOAD_KEYS_TEXT=descricao,endereco,publico,site,email,certificacoes

# BM25 híbrido (recomendado em produção)
# QDRANT_BM25_VECTOR_NAME=bm25_complete_profile
# QDRANT_BM25_MODEL=qdrant/bm25
# QDRANT_BM25_PAYLOAD_KEYS=bm25_complete_profile

# OpenAI
# OPENAI_EMBED_DIMENSIONS=1536

# API de cidades
# CITIES_API_URL=https://api-busca-cidades-buscafornecedor.up.railway.app
# CITIES_FILTER_MAX=80

# Chat X-Ray (harness QA)
# Local/dev: default ligado. Produção (NODE_ENV=production ou Railway): default off.
# XRAY_ENABLED=1          # local OK; em produção só sobe se =1 explícito
# XRAY_ENABLED=0          # força off
# XRAY_CHAT_TTL_MS=3600000
# XRAY_CHAT_MAX_MESSAGES=40
# XRAY_CHAT_MAX_TOOL_ROUNDS=4
# XRAY_LLM_AUTH_TOOLS=1   # 0 = remove register_buyer/login_buyer do chat LLM
# LLM_CHAT_AGENT_MODEL=gpt-4o-mini

# --- Auth + Supabase (ADR 010) ---
# Produção: AUTH_MODE obrigatório (fail-closed se off/ausente)
# Local: AUTH_MODE=off permitido
AUTH_MODE=api_key,supabase_jwt
# REQUIRE_COMPRADOR=1     # ops: só se produto já exige comprador (não forçar no código)
# REQUIRE_ACESSO_AGENTE=1 # produção default on (Railway). 0 = libera chat do agente sem allowlist (X-Ray local)
# AUTH_API_KEYS=sk_legacy_local_only
# AUTH_ENV_KEY_USER_ID=   # opcional: liga key env a um auth.users.id
# AUTH_CACHE_TTL_MS=120000
# LOGIN_MINT_API_KEY=1    # local default on; produção default off se omitido
# MAX_ACTIVE_API_KEYS=5   # 0 = ilimitado
# CORS_ORIGINS=https://app.exemplo.com,http://localhost:3000

SUPABASE_URL=https://hccolkrnyrxcbxuuajwq.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=          # necessário para login-buyer (email+senha)
# DATABASE_URL=postgres://...@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
# NÃO use SUPABASE_CONECTION_STRING — a app só lê DATABASE_URL
# PG_POOL_MAX=8
# PG_SSL=1
# PG_SSL_REJECT_UNAUTHORIZED=0  # 1 após smoke no pooler 6543 (+ PG_SSL_CA se preciso)
# PG_SSL_CA=

# Telemetria async (consultas + aparicoes)
# TELEMETRY_MODE=inline
# TELEMETRY_MODE=off
# TELEMETRY_CONCURRENCY=2

# Camada de comunicação (API notificacao-clientes — fila email/SMS)
# NOTIFICACAO_API_URL=https://notificacao-clientes-buscafornecedor.up.railway.app
# NOTIFICACAO_API_KEY=          # mesma API_KEY Bearer da API de notificação
# NOTIFICACAO_MODE=on           # on | off
# NOTIFICACAO_CONCURRENCY=3
# NOTIFICACAO_API_TIMEOUT_MS=15000
# PREFER_PG_PERSIST=1   # so use se DATABASE_URL = mesmo projeto do SUPABASE_URL



# Servidor
HOST=0.0.0.0
NODE_ENV=production
# PORT=3000
# SEARCH_TIMEOUT_MS=120000

# MCP_URL=http://127.0.0.1:3000/mcp
# SKIP_ENV_VALIDATION=1
